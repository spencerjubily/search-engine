# Existing SearXNG and Ollama endpoints. From a container on the host, use host.docker.internal.
SEARXNG_URL=http://host.docker.internal:8080
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:14b

# Optional: hybrid mode runs SearXNG regardless; Tavily is added when this key is set.
TAVILY_API_KEY=

# Federated academic-paper discovery over the paper-search-mcp stdio server.
PAPER_MCP_ENABLED=true
PAPER_SEARCH_MCP_UNPAYWALL_EMAIL=
PAPER_SEARCH_MCP_CORE_API_KEY=
PAPER_SEARCH_MCP_SEMANTIC_SCHOLAR_API_KEY=
PAPER_SEARCH_MCP_OPENALEX_API_KEY=

# Set a long random value to protect the API. Empty means local unauthenticated development.
AGENT_API_KEY=
REQUEST_TIMEOUT_SECONDS=20
MAX_SEARCH_RESULTS=12
MAX_CONCURRENT_REQUESTS=8
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
